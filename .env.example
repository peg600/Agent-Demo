# Local-only template. scripts/init-local-env.ps1 generates database/cookie secrets.
POSTGRES_PASSWORD=
DATABASE_URL=
CHECKPOINT_DATABASE_URL=
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
WEB_PORT=5173
LOG_LEVEL=info
WEB_ORIGIN=http://127.0.0.1:5173
SESSION_SECRET=

# Use a project API key from the API organization receiving your API credits.
# Do not use Codex login tokens. Never put these in VITE_* variables.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=
# Configure this separately in RAGFlow before creating/embedding a dataset.
OPENAI_EMBEDDING_MODEL=

RAGFLOW_BASE_URL=http://127.0.0.1:8080
RAGFLOW_API_KEY=
RAGFLOW_DATASET_IDS=
KNOWLEDGE_SOURCES_PATH=knowledge/sources.local.json
# MVP uses OpenAI application-side reranking; native RAGFlow reranking is optional later.
RAGFLOW_RERANK_ID=
RERANK_MODE=openai

LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Bounded workflow execution settings.
MAX_TASKS_PER_MESSAGE=5
MAX_TOOL_CALLS_PER_RUN=8
TOOL_TIMEOUT_MS=15000
MODEL_TIMEOUT_MS=60000
